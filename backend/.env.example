# Khedut Mitr multi-provider configuration. Add at least one API key.
# Keep real keys only in .env; never commit .env.

# 1) OpenRouter — recommended zero-cost router
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 2) Mistral — Free mode API access
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 3) Groq — Free-tier API access is rate-limited; model can be changed in console
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 4) Google Gemini — keep this as another fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
